# Feishu / Lark Open Platform credentials
# Create an app at: https://open.feishu.cn/app
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Optional: Redis for caching (uncomment to enable)
# REDIS_URL=redis://localhost:6379/0

# CORS origins (comma separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── DIFY Integration ────────────────────────────────────────
# API Key for DIFY tool authentication (leave empty for dev mode / no auth)
DIFY_API_KEY=

# Public URL of this server (used in DIFY OpenAPI schema)
# Must be reachable by DIFY server (use ngrok for local dev)
PUBLIC_BASE_URL=http://localhost:8000
