# ----------------------------------------------------------------------------
# CXMTCode 环境变量示例 - 复制为 .env 后修改
# ----------------------------------------------------------------------------

# 系统 DB 连接串
# SQLite (开发)：Data Source=db/cxmtcode-dev.db
# Oracle (生产)：Data Source=(DESCRIPTION=...);User Id=CXMT_PLATFORM;Password=...
ConnectionStrings__SystemDb=Data Source=db/cxmtcode-dev.db

# JWT
JwtSettings__SecretKey=ChangeMeInProductionPleaseUseAtLeast32CharsLongRandomSecret!!
JwtSettings__Issuer=CXMTCode
JwtSettings__Audience=CXMTCodeReact
JwtSettings__ExpirationMinutes=480

# 前端跨域
Frontend__Url=http://localhost:5173

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5099
