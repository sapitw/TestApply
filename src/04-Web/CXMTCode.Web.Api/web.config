<?xml version="1.0" encoding="utf-8"?>
<!--
  CXMTCode Web API · IIS 宿主配置
  通过 ASP.NET Core Module v2 (AspNetCoreModuleV2) 反向托管 Kestrel
  部署前需在 Windows Server 上安装：
    1. .NET 8 Hosting Bundle: https://dotnet.microsoft.com/download/dotnet/8.0
       (https://dot.net/v1/dotnet-install.ps1 -Channel 8.0 -Runtime aspnetcore)
    2. URL Rewrite Module (前端站点需要 SPA 回退)
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\CXMTCode.Web.Api.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!--
            注意：以下连接串 / 密钥仅是模板。
            生产环境请改用 IIS 应用程序池的环境变量或 appsettings.Production.json，
            不要把密钥直接写入此文件。
          -->
          <!-- <environmentVariable name="ConnectionStrings__SystemDb" value="..." /> -->
          <!-- <environmentVariable name="JwtSettings__SecretKey" value="..." /> -->
        </environmentVariables>
      </aspNetCore>

      <!-- 隐藏敏感响应头 -->
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="DENY" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        </customHeaders>
      </httpProtocol>

      <!-- 上传体积上限 -->
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="52428800" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
